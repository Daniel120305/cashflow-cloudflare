// Configuração do CashFlow na Cloudflare (Workers).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cashflow",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: o driver pg e o node:crypto funcionam no Worker.
  "compatibility_flags": ["nodejs_compat"],
  // Roda o Worker perto do Supabase (São Paulo, AWS sa-east-1).
  "placement": { "region": "aws:sa-east-1" },
  // Páginas, CSS e JS saem direto da rede da Cloudflare; só /api passa pelo Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Mantém os endereços .html como no Render (sem redirecionar para /login).
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  // Conexão com o Supabase (Hyperdrive "cashflow-db", cache desligado).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9ded02bb260b424fbae0f49e6f5717b9"
    }
  ],
  // Leitura de comprovantes do Telegram (OCR).
  "ai": { "binding": "AI" },
  // Filas do Telegram e alertas a cada 5 min; limpeza de hora em hora.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Valores públicos. Chaves secretas (BREVO_API_KEY, MAIL_FROM, EMAIL_TOKEN_SECRET,
  // TELEGRAM_*) ficam em Settings → Variables and Secrets, como "Secret".
  "vars": {
    "NODE_ENV": "production",
    "APP_ORIGIN": "https://cashflow.danielboucas.workers.dev",
    "GOOGLE_CLIENT_ID": "151840248473-tnnstieeiun7tpjcahpbs1qbnl6tnse4.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
